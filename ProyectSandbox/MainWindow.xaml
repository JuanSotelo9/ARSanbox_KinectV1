<Window x:Class="ProyectoSandbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProyectoSandbox — Kinect Depth Viewer"
        Width="900" Height="620"
        Background="#0D0D0D"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#00E5FF"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="MapBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Padding="9,5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#00E5FF"/>
                                <Setter Property="Background" Value="#001C22"/>
                                <Setter Property="BorderBrush" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Background" Value="#181818"/>
                                <Setter Property="BorderBrush" Value="#2A2A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#FF4040"
                     VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="KINECT" Foreground="#00E5FF" FontFamily="Consolas"
                       FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text=" DEPTH VIEWER" Foreground="#2A2A2A" FontFamily="Consolas"
                       FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text=" · ProyectoSandbox" Foreground="#222222"
                       FontFamily="Consolas" FontSize="11"
                       VerticalAlignment="Bottom" Margin="6,0,0,2"/>
        </StackPanel>

        <!-- CONTENIDO -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="190"/>
            </Grid.ColumnDefinitions>

            <!-- Imagen de profundidad -->
            <Border Grid.Column="0" Background="#080808"
                    BorderBrush="#181818" BorderThickness="1" Margin="0,0,8,0">
                <Image x:Name="DepthImage"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>

            <!-- Panel derecho -->
            <StackPanel Grid.Column="1" Background="#111111">

                <!-- Métricas -->
                <Border BorderBrush="#1A1A1A" BorderThickness="0,0,0,1"
                        Padding="10,10,10,12">
                    <StackPanel>
                        <TextBlock Text="MÉTRICAS" Style="{StaticResource Lbl}"
                                   Foreground="#333" FontSize="9" Margin="0,0,0,7"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="FPS"
                                       Style="{StaticResource Lbl}" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtFps"
                                       Style="{StaticResource Val}" Text="—" Margin="0,2"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Frame"
                                       Style="{StaticResource Lbl}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtFrame"
                                       Style="{StaticResource Val}" Text="—" Margin="0,2"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Centro m"
                                       Style="{StaticResource Lbl}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtCenter"
                                       Style="{StaticResource Val}" Text="—" Margin="0,2"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Min"
                                       Style="{StaticResource Lbl}" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtMin"
                                       Style="{StaticResource Val}" Text="—" Margin="0,2"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Max"
                                       Style="{StaticResource Lbl}" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtMax"
                                       Style="{StaticResource Val}" Text="—" Margin="0,2"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Mapa de color -->
                <Border BorderBrush="#1A1A1A" BorderThickness="0,0,0,1"
                        Padding="10,10,10,12">
                    <StackPanel>
                        <TextBlock Text="MAPA DE COLOR" Style="{StaticResource Lbl}"
                                   Foreground="#333" FontSize="9" Margin="0,0,0,7"/>
                        <WrapPanel>
                            <RadioButton Content="Gris"  Tag="Grayscale"
                                         Style="{StaticResource MapBtn}"
                                         IsChecked="True" Checked="MapBtn_Checked"/>
                            <RadioButton Content="Inv"   Tag="Inverse"
                                         Style="{StaticResource MapBtn}"
                                         Checked="MapBtn_Checked"/>
                            <RadioButton Content="Jet"   Tag="Jet"
                                         Style="{StaticResource MapBtn}"
                                         Checked="MapBtn_Checked"/>
                            <RadioButton Content="Calor" Tag="Hot"
                                         Style="{StaticResource MapBtn}"
                                         Checked="MapBtn_Checked"/>
                        </WrapPanel>
                        <!-- Leyenda: manejada 100% desde código, sin GradientStop con x:Name -->
                        <Border x:Name="LegendContainer"
                                Margin="0,8,0,0" Height="10" CornerRadius="2"/>
                        <Grid Margin="0,3,0,0">
                            <TextBlock Text="0.8m" Style="{StaticResource Lbl}" FontSize="9"/>
                            <TextBlock Text="4.0m" Style="{StaticResource Lbl}" FontSize="9"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Snapshot -->
                <Border Padding="10,10,10,4">
                    <Button x:Name="BtnSnapshot" Content="Guardar PNG"
                            Click="BtnSnapshot_Click"
                            Background="#181818" Foreground="#666666"
                            BorderBrush="#2A2A2A" BorderThickness="1"
                            FontFamily="Consolas" FontSize="11"
                            Padding="0,8" Cursor="Hand"/>
                </Border>

                <!-- Mesh 3D -->
                <Border Padding="10,4,10,10">
                    <Button x:Name="BtnMesh" Content="Ver mesh 3D"
                            Click="BtnMesh_Click"
                            Background="#181818" Foreground="#666666"
                            BorderBrush="#2A2A2A" BorderThickness="1"
                            FontFamily="Consolas" FontSize="11"
                            Padding="0,8" Cursor="Hand"/>
                </Border>

                <!-- Leyenda magenta -->
                <Border Padding="10,0,10,10">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="10" Height="10" Fill="#3C003C"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="= sin datos" Style="{StaticResource Lbl}"
                                   FontSize="9" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="8,4"
                Background="#080808" BorderBrush="#181818" BorderThickness="1">
            <TextBlock x:Name="TxtStatus" Text="Iniciando..."
                       FontFamily="Consolas" FontSize="10" Foreground="#333333"/>
        </Border>
    </Grid>
</Window>